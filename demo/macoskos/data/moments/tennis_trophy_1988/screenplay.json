      "target": "puppet:carol",
      "text": "Carol was thirty-eight, and that night she let the trophy have the best seat at the dinner table."
    },
    {
      "target": "prop:tennis_trophy",
      "text": "A gold cup with a little tennis player on the lid. Jenna would not put it down the whole ride home."
    },
    {
      "target": "prop:tennis_racket",
      "text": "Jenna's wooden racket with the white grip, the one she won it all with at thirteen."
    },
