  "explanations": [
    {
      "target": "puppet:harold",
      "text": "Grandpa Hal was eighty-four and wanted every one of his great-grandkids on his lap at once. He got all three."
    },
    {
      "target": "puppet:evelyn",
      "text": "Evelyn was eighty-two, her pearl brooch pinned on for the picture, and she supervised the whole thing from the porch."
    },
    {
      "target": "puppet:daniel",
      "text": "Daniel was thirty-two and drove three states with three kids in the back, for the leaves and for Grandpa Hal."
    },
    {
      "target": "puppet:carsten",
      "text": "Carsten was five, in his striped sweater, and climbed onto Hal's lap before anyone said he could."
    },
    {
      "target": "puppet:lily_macosko",
      "text": "Lily was two, in pigtails, and kept trying to collect every leaf on the porch."
    },
    {
      "target": "puppet:nora",
      "text": "Nora was a few months old, in her baby bonnet, and fell asleep on Grandpa Hal in the middle of the photo."
    },
    {
      "target": "prop:hal_rocking_chair",
      "text": "Hal's white rocking chair. That afternoon it held one great-grandpa and three great-grandkids."
    },
    {
      "target": "prop:porch_flag",
      "text": "Hal put the flag out every morning of his life after the Navy."
    },
    {
      "target": "puppet:jenna",
      "text": "Jenna was thirty and passed the kids up onto Hal's lap one by one, the baby last."
    }
  ]
