      "narration": [
        {
          "t": 0.15,
          "text": "Jenna was six weeks old the first time we drove to the coast in our little red van.",
          "source": "telling:carol:s1",
          "cue": "drive",
          "cueWord": "drove"
        },
        {
          "t": 5.35,
          "text": "Mark waved at every car the whole way,",
          "source": "telling:carol:s2",
          "cue": "waves",
          "cueWord": "waved"
        },
        {
          "t": 8.9,
          "text": "and Jenna slept through all of it.",
          "source": "telling:carol:s3",
          "cue": "asleep",
          "cueWord": "slept"
        }
      ],
      "transition": "fold",
      "pageText": "Summer 1975. The little red van, a plaid suitcase on the roof, and a baby asleep the whole way to the sea."
    }
