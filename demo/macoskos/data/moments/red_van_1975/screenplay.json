  "explanations": [
    {
      "target": "puppet:carol",
      "text": "Carol was twenty-five, and she did all the driving: nobody else could work the van's gears."
    },
    {
      "target": "puppet:mark",
      "text": "Mark was four. He waved at every car the whole way, and counted every one that waved back."
    },
    {
      "target": "puppet:jenna",
      "text": "Jenna was six weeks old, on her very first trip to the coast, and slept through all of it."
    },
    {
      "target": "prop:red_van",
      "text": "The little red van with the white roof rack. It had a sliding door that stuck, and no radio."
    },
    {
      "target": "prop:macosko_suitcase",
      "text": "The brown plaid suitcase strapped to the roof rack held everything the three of them needed."
    }
  ]
