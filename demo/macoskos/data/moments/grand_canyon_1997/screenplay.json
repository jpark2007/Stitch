      "narration": [
        {
          "t": 0,
          "text": "Mark bought a blue station wagon that summer and decided we had to drive it to the Grand Canyon.",
          "source": "telling:jenna:s1"
        },
        {
          "t": 5.0,
          "text": "I sat in the back with a map I refused to read.",
          "source": "telling:jenna:s2",
          "cue": "back_seat",
          "cueWord": "sat"
        }
      ],
      "transition": "fold",
      "pageText": "Summer 1997. Mark bought a station wagon and decided the three of them were driving it to the Grand Canyon."
