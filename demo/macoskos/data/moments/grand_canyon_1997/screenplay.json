      "narration": [
        {
          "t": 5.2,
          "text": "We got a flat tire outside a cherry stand.",
          "source": "telling:jenna:s3",
          "cue": "fix",
          "cueWord": "flat"
        },
        {
          "t": 8.0,
          "text": "We sat on a fruit crate and ate cherries while he fixed it.",
          "source": "telling:jenna:s4",
