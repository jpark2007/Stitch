  "explanations": [
    {
      "target": "puppet:jenna",
      "text": "Jenna was twenty-two, in the back seat with a map she refused to read. She ate so many cherries she was sick the rest of the way."
    },
    {
      "target": "puppet:mark",
      "text": "Mark was twenty-six and would not let anyone else drive his new car. When the tire went flat, he changed it in his good trousers."
    },
    {
      "target": "puppet:carol",
      "text": "Carol was forty-seven and rode up front. At the cherry stand she sat on the fruit crate with Jenna and watched Mark fix the tire."
    },
    {
      "target": "prop:mark_wagon",
      "text": "Mark's blue station wagon with a roof rack, bought that summer. He decided on the spot it had to see the Grand Canyon."
    },
    {
      "target": "prop:cherries",
      "text": "A paper bag of dark red cherries from the stand where the tire went flat. Jenna ate most of them before the spare was on."
    },
    {
      "target": "prop:road_atlas",
      "text": "The big folded road map of the Southwest. Jenna was in charge of it and refused to read a single fold."
    },
    {
      "target": "prop:cherry_crate",
      "text": "An upturned fruit crate by the cherry stand: the best seat in Arizona while Mark fixed the tire."
    }
  ]
