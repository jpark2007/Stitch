  "explanations": [
    {
      "target": "puppet:lily_macosko",
      "text": "Lily was eighteen, in a gown too long for her. She caught the hem on the second step and turned it into a bow."
    },
    {
      "target": "puppet:jenna",
      "text": "Jenna was forty-six. Outside, Lily handed her the diploma, and Jenna would not let go of her."
    },
    {
      "target": "puppet:daniel",
      "text": "Daniel was forty-eight and took the aisle seat so he could jump up for photos. He took ninety that day, and three are in focus."
    },
    {
      "target": "puppet:carsten",
      "text": "Carsten was twenty-one, and he saw Lily's foot catch first. He still brings up that bow every Thanksgiving."
    },
    {
      "target": "puppet:carol",
      "text": "Carol was seventy-one, in the front row in her pale blue hat, and clapped louder than anyone in the hall."
    },
    {
      "target": "puppet:linda",
      "text": "Linda was seventy-one too, right beside Carol in the very same hat. Neither of them has ever admitted to planning it."
    },
    {
      "target": "prop:lily_diploma",
      "text": "Lily's diploma, tied with a blue ribbon. It went straight from Lily's hands to her mom's."
    },
    {
      "target": "prop:hall_lectern",
      "text": "The lectern where the diplomas waited. Lily had to cross the whole stage to reach hers, right after the bow."
    },
    {
      "target": "prop:carol_hat",
      "text": "Carol's pale blue hat with a white silk flower, bought specially for the day."
    },
    {
      "target": "prop:linda_hat",
      "text": "Linda's hat: the very same pale blue hat with the very same white silk flower. Nobody planned it."
    },
    {
      "target": "prop:folding_chair_carol",
      "text": "Carol's chair in the front row, close enough to the stage to clap the loudest."
    },
    {
      "target": "prop:folding_chair_linda",
      "text": "Linda's chair, front row, right next to Carol's: two grandmothers, two matching hats."
    },
    {
      "target": "prop:folding_chair_jenna",
      "text": "Jenna's chair, right behind the grandmothers. She was crying in it from the first name called."
    },
    {
      "target": "prop:folding_chair_carsten",
      "text": "Carsten's chair, behind the grandmothers, with a clear view of the stage stairs and Lily's famous bow."
    },
    {
      "target": "prop:folding_chair_daniel",
      "text": "Daniel's chair on the aisle. He was barely in it, he was up taking photos so often."
    }
  ]
}