        },
        {
          "t": 7.9,
          "text": "Carol clapped louder than anyone in the hall.",
          "source": "telling:jenna:s3",
          "cue": "clap",
          "cueWord": "clapped"
        }
      ],
      "transition": "fold",
      "pageText": "Class of 2021. The whole family came, two grandmas wore matching hats, and Lily turned a trip on the stairs into a bow."
