        },
        {
          "t": 8.8,
          "text": "Lily and Nora wouldn't leave her side.",
          "source": "telling:carol:s3",
          "cue": "girls",
          "cueWord": "Lily"
        }
      ],
      "transition": "fold",
      "pageText": "July 2011. Rose turned eighty in the big wicker loveseat, with a brand-new twin on each side."
