  "explanations": [
    {
      "target": "puppet:rose",
      "text": "Rose was eighty that day, silver pendant on, and laughed so hard that Theo started laughing too."
    },
    {
      "target": "puppet:carol",
      "text": "Carol was sixty-one. She put her mother in the big wicker loveseat with a brand-new twin on each side."
    },
    {
      "target": "puppet:theo",
      "text": "Theo was a few weeks old, in his mint onesie. He started laughing when Rose did, and didn't stop."
    },
    {
      "target": "puppet:max",
      "text": "Max, Theo's twin and the sleepier one, dozed through most of the party on Rose's other side."
    },
    {
      "target": "puppet:lily_macosko",
      "text": "Lily was eight and would not leave her great-grandmother's side. She appointed herself Rose's assistant for the day."
    },
    {
      "target": "puppet:nora",
      "text": "Nora was six and stuck to Rose's side with her big sister, not even leaving for cake."
    },
    {
      "target": "prop:rose_cake",
      "text": "A white cake with pink roses, for Rose. Eighty years of wishes, one big breath."
    },
    {
      "target": "prop:wicker_loveseat",
      "text": "The big white wicker loveseat with the flowered cushion: one great-grandma and two brand-new twins, all at once."
    }
  ]
