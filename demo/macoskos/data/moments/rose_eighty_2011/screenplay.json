      "narration": [
        {
          "t": 0.5,
          "text": "For Mom's eightieth we put her in the big wicker loveseat with the brand-new twins.",
          "source": "telling:carol:s1",
          "cue": "cake_in",
          "cueWord": "eightieth"
        },
        {
          "t": 5.6,
          "text": "She laughed so hard Theo started laughing too.",
