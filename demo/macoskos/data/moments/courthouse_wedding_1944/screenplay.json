      "narration": [
        {
          "t": 0.35,
          "text": "My shipmates stood up for me in their dress blues on the courthouse steps.",
          "source": "telling:harold:s2",
          "cue": "vows",
          "cueWord": "shipmates"
        }
      ],
      "transition": "fold",
      "pageText": "Four sailors in dress blues, one bride, and a whole sack of rice."
    }
  ],
  "narrations": {
    "evelyn": {
      "s1": [
        {
          "t": 0.0,
          "text": "Hal makes it sound like a parade.",
          "source": "telling:evelyn:s1",
          "cue": "arrive",
          "cueWord": "parade"
        },
        {
          "t": 5.35,
          "text": "I held on to those roses the whole time, because they were Mother's.",
          "source": "telling:evelyn:s2",
          "cue": "roses",
          "cueWord": "roses"
        }
      ],
      "s2": [
        {
          "t": 3.45,
          "text": "His shipmates threw a whole sack of rice at us on the way down,",
          "source": "telling:evelyn:s3",
          "cue": "down",
          "cueWord": "rice"
        },
        {
          "t": 7.9,
          "text": "and Hal laughed so hard he nearly lost his cap.",
          "source": "telling:evelyn:s4",
          "cue": "cheer",
          "cueWord": "laughed"
        }
      ]
    }
  },
