  "explanations": [
    {
      "target": "puppet:harold",
      "text": "Hal was twenty-three, with three days of shore leave and no intention of wasting one. His shipmates stood up for him in their dress blues."
    },
    {
      "target": "puppet:evelyn",
      "text": "Evelyn was twenty-one, with her pearl brooch pinned on for the day. She held her mother's roses tight all the way down the steps, rice and all."
    },
    {
      "target": "prop:white_roses",
      "text": "White roses from her mother's garden, tied with a long white ribbon. Evelyn would not let go of them, because they were Mother's."
    },
    {
      "target": "prop:hal_sailor_cap",
      "text": "Hal's white sailor cap. When the rice came down he laughed so hard he nearly lost it on the courthouse steps."
    }
  ]
