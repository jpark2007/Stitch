      "narration": [
        {
          "t": 0.15,
          "text": "I had three days of leave, so we didn't wait.",
          "source": "telling:harold:s1",
          "cue": "arrive",
          "cueWord": "leave"
        },
        {
          "t": 5.85,
          "text": "Evelyn carried white roses from her mother's garden.",
