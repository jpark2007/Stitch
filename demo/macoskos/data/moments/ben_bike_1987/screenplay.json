      "narration": [
        {
          "t": 0,
          "text": "It was a blue bike with a bell, two sizes too big because I said he would grow into it.",
          "source": "telling:rick:s1",
          "cue": "on_bike",
          "cueWord": "blue"
        },
        {
          "t": 5.0,
          "text": "I ran behind him holding the seat up and down the whole street.",
          "source": "telling:rick:s2",
          "cue": "steady",
          "cueWord": "holding"
        }
      ],
      "transition": "fold",
      "pageText": "Spring 1987. A blue bike two sizes too big, and Dad running behind, holding the seat."
