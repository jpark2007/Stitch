  "explanations": [
    {
      "target": "puppet:rick",
      "text": "Rick was thirty-nine. He bought the bike two sizes too big on purpose, then ran the whole street behind it holding the seat."
    },
    {
      "target": "puppet:ben",
      "text": "Ben was six and could barely reach the pedals. When Dad let go, he rang the bell all the way to the corner so Dad would know he was fine."
    },
    {
      "target": "prop:ben_bike",
      "text": "Ben's first bike: blue, with a silver bell, two sizes too big. He rode it until he really did grow into it."
    }
  ]
