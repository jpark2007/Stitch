      "narration": [
        {
          "t": 0,
          "text": "Every Sunday my mother made pancakes, and the whole kitchen smelled of butter and syrup.",
          "source": "telling:rick:s1",
          "cue": "pot_down",
          "cueWord": "syrup"
        },
        {
          "t": 4.6,
          "text": "I was allowed to pour the batter, badly.",
          "source": "telling:rick:s2",
          "cue": "masa",
          "cueWord": "batter"
        }
      ],
      "transition": "fold",
      "pageText": "Sunday at Evelyn's: butter on the griddle, batter everywhere, and one very lopsided pancake."
    },
