  "explanations": [
    {
      "target": "puppet:rick",
      "text": "Rick was ten. Pouring the batter was his job, and he did it badly and proudly."
    },
    {
      "target": "puppet:evelyn",
      "text": "Evelyn was thirty-five and made pancakes every Sunday, until the whole kitchen smelled of butter and syrup."
    },
    {
      "target": "puppet:harold",
      "text": "Hal was thirty-seven. He always ate Rick's lopsided pancake first and swore it was the best he had ever eaten."
    },
    {
      "target": "prop:pancake_pan",
      "text": "Evelyn's big cast-iron pan. It is still in the family, and nobody else is allowed to wash it."
    },
    {
      "target": "prop:lopsided_pancake",
      "text": "Rick's pancake, more batter than shape. Hal held it up like a prize."
    },
    {
      "target": "prop:evelyn_kitchen_table",
      "text": "The square kitchen table with the yellow oilcloth, where every Sunday breakfast happened."
    },
    {
      "target": "prop:hal_kitchen_chair",
      "text": "Hal's ladder-back chair. Nobody else sat in it on Sundays."
    },
    {
      "target": "prop:rick_stool",
      "text": "Rick's little painted stool, right next to his father's chair."
    }
  ]
