  "explanations": [
    {
      "target": "puppet:evelyn",
      "text": "Evelyn was twenty. That night she told her sister she was going to marry the sailor who couldn't dance."
    },
    {
      "target": "puppet:harold",
      "text": "Hal was twenty-two, on shore leave, with two left feet. He asked Evelyn to sit the dance out instead."
    },
    {
      "target": "prop:evelyn_soda",
      "text": "A tall soda with two paper straws. Hal made her laugh so hard that most of it ended up spilled."
    },
    {
      "target": "prop:soda_table",
      "text": "The little table where they sat out every song, half the night."
    },
    {
      "target": "prop:hal_sailor_cap",
      "text": "Hal's white sailor cap. He took it off to ask her, then forgot to put it back on."
    },
    {
      "target": "prop:hall_chair_hal",
      "text": "Hal's chair. He stayed in it all night rather than risk the dance floor."
    },
    {
      "target": "prop:hall_chair_evelyn",
      "text": "Evelyn's chair at the little table, where she laughed so hard the soda went over."
    },
    {
      "target": "prop:soda_bottle",
      "text": "A green glass soda bottle, shared across the table while Hal told joke after joke."
    }
  ]
