  "narrations": {
    "rick": {
      "s1": [
        {
          "t": 0,
          "text": "Daniel looked exactly like he did on his first day of school, terrified and pretending not to be.",
          "source": "telling:rick:s1"
        },
        {
          "t": 4.85,
          "text": "Ben saved the day with the rings.",
          "source": "telling:rick:s2",
