  "explanations": [
    {
      "target": "puppet:daniel",
      "text": "Daniel was twenty-seven and so nervous he forgot who was carrying the rings. His dad says he looked just like his first day of school."
    },
    {
      "target": "puppet:ben",
      "text": "Ben was nineteen, in charge of the rings, and of keeping his big brother calm. He pressed the box into Daniel's hand like it was nothing."
    },
    {
      "target": "puppet:linda",
      "text": "Linda was fifty. She held Rick's hand through the vows, cried through most of the party, and hugged Daniel so hard his flower fell off."
    },
    {
      "target": "puppet:rick",
      "text": "Rick was fifty-two. When the confetti came down he waved at every single guest, including several he had never met."
    },
    {
      "target": "prop:wedding_ring_box",
      "text": "A navy velvet ring box with two gold rings. Ben kept it in his jacket pocket all morning and checked it every five minutes."
    },
    {
      "target": "prop:orchard_bench",
      "text": "The front bench under the apple trees, where Rick and Linda held hands through the whole ceremony."
    },
    {
      "target": "prop:daniel_boutonniere",
      "text": "A single white rose on a pearl pin. Linda's hug knocked it off at the party, and Ben saved it again."
    }
  ]
}