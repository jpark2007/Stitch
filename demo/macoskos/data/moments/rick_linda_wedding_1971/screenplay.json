  "narrations": {
    "evelyn": {
      "s1": [
        {
          "t": 0,
          "text": "Linda always says it rained, and Rick always says it didn't.",
          "source": "telling:evelyn:s1",
          "cue": "arrive",
          "cueWord": "rained"
        },
        {
          "t": 5.6,
          "text": "The one photo we have shows wet steps and a lot of umbrellas.",
