      "narration": [
        {
          "t": 0,
          "text": "It rained all morning, and I was sure the whole day was ruined.",
          "source": "telling:linda:s1"
        },
        {
          "t": 4.8,
          "text": "Rick showed up with his good shoes soaked through and gave me his umbrella without a word.",
