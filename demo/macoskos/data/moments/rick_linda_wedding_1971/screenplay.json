          "cueWord": "umbrellas"
        }
      ],
      "s2": [
        {
          "t": 4.2,
          "text": "So I think she wins that one.",
          "source": "telling:evelyn:s3",
          "cue": "socks",
          "cueWord": "wins"
        }
      ]
