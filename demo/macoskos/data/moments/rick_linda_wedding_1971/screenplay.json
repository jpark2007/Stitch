      "narration": [
        {
          "t": 0,
          "text": "By the time we came out of the chapel the sun was out.",
          "source": "telling:linda:s3",
          "cue": "out",
          "cueWord": "sun"
        },
        {
          "t": 3.8,
          "text": "And everyone was laughing at his socks.",
          "source": "telling:linda:s4",
          "cue": "socks",
          "cueWord": "laughing"
        }
      ],
      "transition": "fold",
      "pageText": "Then the sun came out, the rice flew, and everyone laughed at Rick's soggy socks."
    }
