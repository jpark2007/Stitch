  "explanations": [
    {
      "target": "puppet:linda",
      "text": "Linda was twenty-one and sure the rain had ruined the whole day. By the time they came out of the chapel, the sun was out."
    },
    {
      "target": "puppet:rick",
      "text": "Rick was twenty-three. He showed up with his good shoes soaked through and stood through the vows in wet socks."
    },
    {
      "target": "prop:rick_umbrella",
      "text": "Rick's big black umbrella. He handed it to Linda on the chapel steps without a word and stood in the rain himself."
    }
  ]
