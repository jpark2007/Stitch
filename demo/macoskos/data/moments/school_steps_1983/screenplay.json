  "explanations": [
    {
      "target": "puppet:amy",
      "text": "Amy was eight, in her sailor dress, and very sure she was the best-dressed one on the steps."
    },
    {
      "target": "puppet:daniel",
      "text": "Daniel was ten, the eldest, and starting fifth grade. He kept fixing his tie the whole time."
    },
    {
      "target": "puppet:katie",
      "text": "Katie was five, in her ruffle collar, and could not stop bouncing on the step."
    },
    {
      "target": "puppet:ben",
      "text": "Ben was two. He was not starting anything, and he refused to be left out of the picture."
    },
    {
      "target": "puppet:linda",
      "text": "Linda was thirty-three and lined all four up on the stone steps by the garden gate, smallest last."
    },
    {
      "target": "prop:linda_camera",
      "text": "Linda's boxy film camera. She took a photo on those steps every first day of school."
    },
    {
      "target": "prop:amy_lunchbox",
      "text": "Amy's red metal lunchbox, shaped like a little suitcase."
    },
    {
      "target": "prop:daniel_schoolbooks",
      "text": "Daniel's stack of school books in a leather strap, ready for fifth grade."
    }
  ]
