      "narration": [
        {
          "t": 0.95,
          "text": "Mom lined all four of us up on the stone steps by the garden gate for the first day of school.",
          "source": "telling:amy:s1",
          "cue": "lineup",
          "cueWord": "lined"
        },
        {
          "t": 6.5,
          "text": "Daniel kept fixing his tie,",
          "source": "telling:amy:s2",
          "cue": "tie",
          "cueWord": "fixing"
        },
        {
          "t": 8.45,
          "text": "I wore my sailor dress,",
          "source": "telling:amy:s3",
          "cue": "dress",
          "cueWord": "sailor"
        },
        {
          "t": 11.4,
          "text": "and Ben, who wasn't even in school yet, refused to be left out.",
          "source": "telling:amy:s4",
          "cue": "not_left_out",
          "cueWord": "refused"
        }
      ],
      "transition": "fold",
      "pageText": "September 1983. Four Macoskos on the garden steps for the first day of school, smallest last."
    }
