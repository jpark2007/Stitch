  "explanations": [
    {
      "target": "prop:marmalade",
      "text": "Marmalade, a tiny orange tabby from the shelter. He was named before the kitchen door was even shut."
    },
    {
      "target": "puppet:carol",
      "text": "Carol was forty-nine and had sworn off cats for good. Then she came home from the shelter with a kitten in her coat."
    },
    {
      "target": "puppet:jenna",
      "text": "Jenna was twenty-four and home that spring. She named him Marmalade on the spot."
    },
    {
      "target": "prop:kitten_basket",
      "text": "The little wicker basket with the cream cushion. Marmalade never once slept in it."
    },
    {
      "target": "prop:jenna_water_bottle",
      "text": "Jenna had just come back from a run. The water bottle never got opened."
    },
    {
      "target": "prop:macosko_kitchen_table",
      "text": "The little round kitchen table where Marmalade ate his first dinner, off a saucer."
    }
  ]
