  "explanations": [
    {
      "target": "puppet:rick",
      "text": "Rick was thirty-six and took the stern with his paddle. The canoe held four Macoskos just fine, until Ben stood up."
    },
    {
      "target": "puppet:linda",
      "text": "Linda was thirty-four. She sewed all six pairs of matching overalls so nobody could get lost, and counted heads from the shore."
    },
    {
      "target": "puppet:katie",
      "text": "Katie was six. She came up out of the lake cheering, and she still says it was the best day of the summer."
    },
    {
      "target": "puppet:ben",
      "text": "Ben was three, and the first one to stand up."
    },
    {
      "target": "puppet:daniel",
      "text": "Daniel was eleven, up in the bow, and leaning for the far shore when it all went over."
    },
    {
      "target": "puppet:amy",
      "text": "Amy was nine and stayed on the shore with Mom, which she still says was the smart choice."
    },
    {
      "target": "prop:red_canoe",
      "text": "The long red canoe with four plank seats: one for each Macosko who went in the lake."
    },
    {
      "target": "prop:picnic_basket",
      "text": "Linda's picnic basket with the red checked lid. It stayed on the shore with her, so lunch stayed dry."
    },
    {
      "target": "prop:rick_paddle",
      "text": "Rick's long wooden paddle. It went into the lake along with everyone else."
    }
  ]
}