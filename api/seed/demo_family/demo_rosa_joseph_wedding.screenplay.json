      "narration": [
        {
          "t": 0,
          "text": "It rained all morning, and I was sure the whole day was ruined.",
          "source": "telling:grandma_rosa:s1"
        },
        {
          "t": 4.8,
          "text": "Joseph showed up with his good shoes soaked through and gave me his umbrella without a word.",
          "source": "telling:grandma_rosa:s2",
          "cue": "umbrella",
          "cueWord": "gave"
        }
      ],
      "transition": "fold",
      "pageText": "June 1958, on the same church steps where David would meet Ana. It poured, and Joseph gave Rosa his umbrella."
