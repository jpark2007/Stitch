      "narration": [
        {
          "t": 0,
          "text": "It rained all morning, and I was sure the whole day was ruined.",
          "source": "telling:grandma_rosa:s1"
        },
        {
          "t": 3.4,
          "text": "Joseph showed up with his good shoes soaked through and gave me his umbrella without a word.",
          "source": "telling:grandma_rosa:s2",
          "cue": "umbrella",
          "cueWord": "gave"
        },
        {
          "t": 7.8,
          "text": "By the time we came out of the church the sun was out.",
          "source": "telling:grandma_rosa:s3",
          "cue": "hug",
          "cueWord": "sun"
        },
        {
          "t": 11.6,
          "text": "And everyone was laughing at his socks.",
          "source": "telling:grandma_rosa:s4",
          "cue": "socks",
          "cueWord": "laughing"
        }
      ],
      "transition": "fold",
      "pageText": "June 1958. It poured on the church steps, and Joseph gave Rosa his umbrella without a word."
    }
  ],
  "narrations": {
    "dad": {
      "s1": [
        {
          "t": 0,
          "text": "Mom always says it rained, and Dad always says it didn't.",
          "source": "telling:dad:s1"
        },
        {
          "t": 4.5,
          "text": "The one photo we have shows wet steps and a lot of umbrellas.",
