  "explanations": [
    {
      "target": "puppet:grandma_rosa",
      "text": "Rosa was twenty and sewed her own hem the night before. Thirty years later, her son David met Ana on these same church steps."
    },
    {
      "target": "puppet:grandpa_joseph",
      "text": "Joseph was twenty-four. He walked from the bus stop in the rain rather than be late, and stood through the vows in wet socks."
    },
    {
      "target": "prop:black_umbrella",
      "text": "Joseph's only umbrella. He gave it to Rosa on the steps and stood in the rain himself. She kept it, and it still hangs by her door."
    }
  ]
