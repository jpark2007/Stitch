  "explanations": [
    {
      "target": "puppet:grandma_rosa",
      "text": "Rosa was twenty and had sewn the hem of her dress herself the night before."
    },
    {
      "target": "puppet:grandpa_joseph",
      "text": "Joseph was twenty-four. He walked the whole way from the bus stop in the rain rather than be late."
    },
    {
      "target": "prop:black_umbrella",
      "text": "Joseph's only umbrella. He gave it to Rosa on the steps and stood in the rain himself."
