  "explanations": [
    {"target": "puppet:dad", "text": "David was ten, in the back seat, and in charge of the map. He ate more peaches than anyone."},
    {
      "target": "puppet:grandpa_joseph",
      "text": "Joseph drove every mile himself. Nobody else was allowed behind the wheel of the green sedan."
    },
    {"target": "puppet:grandma_rosa", "text": "Rosa packed sandwiches nobody ate, because of the peaches."},
