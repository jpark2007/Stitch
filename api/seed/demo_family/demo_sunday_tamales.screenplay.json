      "narration": [
        {
          "t": 0,
          "text": "Every Sunday my mother made tamales, and the whole kitchen smelled of corn husks.",
          "source": "telling:mom:s1",
          "cue": "pot_down",
          "cueWord": "husks"
        },
        {"t": 3.8, "text": "I was allowed to spread the masa, badly.", "source": "telling:mom:s2"},
        {
          "t": 6.0,
          "text": "My father pretended every lumpy one was the best he had ever eaten.",
          "source": "telling:mom:s3",
          "cue": "tamale",
          "cueWord": "lumpy"
        }
      ],
      "transition": "fold",
      "pageText": "Sunday at Carmen's: steam on the windows, masa on every hand, and one very lumpy tamale for Luis."
    }
