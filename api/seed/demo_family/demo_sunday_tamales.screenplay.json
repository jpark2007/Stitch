      "narration": [
        {
          "t": 0,
          "text": "Every Sunday my mother made tamales, and the whole kitchen smelled of corn husks.",
          "source": "telling:mom:s1",
          "cue": "pot_down",
          "cueWord": "husks"
        },
        {
          "t": 4.6,
          "text": "I was allowed to spread the masa, badly.",
          "source": "telling:mom:s2",
          "cue": "masa",
          "cueWord": "masa"
        }
      ],
      "transition": "fold",
      "pageText": "Sunday at Carmen's: steam on the windows, masa on every hand, and one very lumpy tamale."
    },
