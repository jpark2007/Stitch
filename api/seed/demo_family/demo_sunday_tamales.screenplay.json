  "explanations": [
    {
      "target": "puppet:mom",
      "text": "Ana was six. Spreading the masa was her job, and she took it very seriously."
    },
    {
      "target": "puppet:grandma_carmen",
      "text": "Carmen made tamales every Sunday for forty years, from her own mother's recipe."
    },
    {
      "target": "puppet:grandpa_luis",
      "text": "Luis came in from the garden every Sunday at noon, still in his straw hat, and always ate Ana's tamale first."
    },
    {
      "target": "prop:tamale_pot",
      "text": "The dented steamer pot. Carmen still has it, and still will not let anyone else wash it."
    },
    {
      "target": "prop:lumpy_tamale",
      "text": "Ana's tamale, more masa than husk. Luis held it up like a prize and called it the best of the batch."
    },
    {"target": "prop:kitchen_table", "text": "The kitchen table where every tamale in the family was folded."},
    {"target": "prop:kitchen_chair", "text": "Luis's chair. Nobody else sat in it on Sundays."},
    {
      "target": "prop:kitchen_stool",
      "text": "Ana's painted stool, the only seat she could climb onto by herself. It stood next to her father's chair."
    },
    {
      "target": "prop:luis_straw_hat",
      "text": "Luis's straw hat, his signature. He wore it in the garden, at the table, and in every photo."
    }
  ]
