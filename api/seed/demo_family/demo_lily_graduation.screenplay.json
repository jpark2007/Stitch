      "narration": [
        {
          "t": 0,
          "text": "Both grandmothers came and sat in the front row in matching hats, which was not planned.",
          "source": "telling:mom:s1",
          "cue": "hats",
          "cueWord": "grandmothers"
        },
        {
          "t": 4.2,
          "text": "Lily tripped on the stage stairs and turned it into a bow.",
          "source": "telling:mom:s2",
          "cue": "bow",
          "cueWord": "bow"
        },
        {
          "t": 7.9,
          "text": "Rosa clapped louder than anyone in the hall.",
          "source": "telling:mom:s3",
          "cue": "clap",
          "cueWord": "clapped"
        }
      ],
      "transition": "fold",
      "pageText": "Class of 2015. The whole family came, two grandmas wore matching hats, and Lily turned a trip on the stairs into a bow."
    },
