  "narrations": {
    "lily": {
      "s1": [
        {
          "t": 5.4,
          "text": "My gown was too long and I caught the hem on the second step.",
          "source": "telling:lily:s1",
          "cue": "bow",
          "cueWord": "caught"
        },
        {
          "t": 9.4,
          "text": "I figured if I bowed nobody would know.",
