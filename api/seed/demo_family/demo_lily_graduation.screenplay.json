  "explanations": [
    {"target": "puppet:lily", "text": "Lily was twenty-two, the first in the family to finish college."},
    {"target": "puppet:mom", "text": "Ana sat right behind Rosa and cried from the first name called to the last."},
    {
      "target": "puppet:dad",
      "text": "David took the aisle seat so he could jump up for photos. He took ninety that day, and three are in focus."
    },
    {
      "target": "puppet:sam",
      "text": "Sam drove four hours to be there. From his seat behind the grandmothers he saw Lily's foot catch first, and he has brought it up every Thanksgiving since."
    },
    {
      "target": "puppet:grandma_rosa",
      "text": "Rosa was seventy-seven and clapped louder than anyone in the hall."
    },
    {
      "target": "puppet:grandma_carmen",
      "text": "Carmen wore the same hat as Rosa. Neither of them has ever admitted to planning it."
    },
    {
      "target": "prop:diploma",
      "text": "Lily's diploma, tied with a blue ribbon. It hangs in Ana's hallway now."
    },
    {"target": "prop:lectern", "text": "The lectern where the diplomas waited. Lily had to cross the whole stage to reach hers."},
    {
      "target": "prop:folding_chair_rosa",
      "text": "Rosa's front-row seat, saved for her since seven that morning."
    },
    {
      "target": "prop:folding_chair_carmen",
      "text": "Carmen's seat, right next to Rosa's in the front row, which is how the whole hall noticed the matching hats."
    },
    {
      "target": "prop:folding_chair_mom",
      "text": "Ana's seat in the second row, right behind Rosa, close enough to pass the tissues forward."
    },
    {
      "target": "prop:folding_chair_sam",
      "text": "Sam's seat in the second row, between his parents, looking out between the two grandmothers' hats. Carmen turned round and shushed him when he laughed at the bow."
    },
    {
      "target": "prop:folding_chair_dad",
      "text": "David's seat on the aisle, picked so he could stand up for photos without blocking anyone's view."
    },
    {
      "target": "prop:rosa_hat",
      "text": "Rosa's pale blue hat with a white silk flower, bought specially for the day."
    },
    {
      "target": "prop:carmen_hat",
      "text": "Carmen's hat: the very same pale blue hat, from the very same shop. Nobody planned it, and nobody has ever confessed."
    }
  ]
}
