  "explanations": [
    {
      "target": "puppet:dad",
      "text": "David was thirty-five. He bought the bike a size up on purpose, then ran the whole street behind it."
    },
    {
      "target": "puppet:sam",
      "text": "Sam was seven and could barely reach the pedals. He would not admit he was scared."
    },
    {
      "target": "prop:red_bike",
      "text": "Sam's first bike: red, with a silver bell, two sizes too big. He rode it until he really did grow into it."
    },
    {
      "target": "prop:sam_cap",
      "text": "Sam's teal baseball cap, worn backwards so it would not blow off. It became his signature."
    }
