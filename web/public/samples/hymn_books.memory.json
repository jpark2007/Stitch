   "explanations": [
    {
     "target": "puppet:dad",
     "text": "Dad was 26 and had only come to church that Sunday because his mother asked."
    },
    {
     "target": "puppet:mom",
     "text": "Mom sang in the choir, and carried the hymn books in every week."
    },
    {
     "target": "prop:hymn_books",
     "text": "The hymn books Mom dropped on the steps. Dad says it is the best thing that ever fell at his feet."
