MONGODB_URI=
JWT_SECRET=
ANTHROPIC_API_KEY=
IMAGE_API_KEY=
# Image provider: higgsfield, cloudflare or openai; blank: Higgsfield if HIGGSFIELD_API_KEY is set, else Cloudflare if CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN are both set, else OpenAI if IMAGE_API_KEY is set, else placeholder art
IMAGE_PROVIDER=
# Higgsfield API key ID from https://console.higgsfield.ai (or id:secret in one value)
HIGGSFIELD_API_KEY=
# Higgsfield API key secret (not needed when HIGGSFIELD_API_KEY is id:secret)
HIGGSFIELD_API_SECRET=
# Optional; default https://api.higgsfield.ai
HIGGSFIELD_API_URL=
# Optional endpoint id; default recraft/v4.1/text-to-image (also higgsfield-ai/soul/standard, higgsfield-ai/soul/v2/standard)
HIGGSFIELD_IMAGE_MODEL=
# Optional text appended to every Higgsfield prompt; blank: the built-in flat cut-paper hint; none: no suffix
HIGGSFIELD_STYLE_SUFFIX=
# Optional extra comma-separated hosts Higgsfield results may be downloaded from (default: higgsfield.ai and subdomains)
HIGGSFIELD_RESULT_HOSTS=
# Cloudflare Workers AI account ID (dashboard: Workers AI, Use REST API); free tier: 10,000 Neurons a day, about 96 default images
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with Workers AI Read and Edit
CLOUDFLARE_API_TOKEN=
# Optional; default https://api.cloudflare.com/client/v4
CLOUDFLARE_API_URL=
# Optional model id; default @cf/black-forest-labs/flux-2-klein-4b (also @cf/black-forest-labs/flux-2-klein-9b, @cf/leonardo/phoenix-1.0)
CLOUDFLARE_IMAGE_MODEL=
# Optional text appended to every Cloudflare prompt; blank: the built-in flat cut-paper hint; none: no suffix
CLOUDFLARE_STYLE_SUFFIX=
